# ============================================================
# AdaptiPing — Root .gitignore
# Combined Next.js (TypeScript) + FastAPI (Python) Project
# ============================================================

# ------------------------------------------------------------
# Node / Frontend Dependencies & Builds
# ------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
coverage/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------
# Python / Backend Bytecode & Caches
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------
# Environment & Secrets (Keep .env.example tracked)
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Logs & Process Output
# ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------
# IDE & Editor Configuration
# ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# Temporary Files
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.old
*.swp
*~
