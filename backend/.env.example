# ============================================================
# AdaptiPing — Backend Environment Variables Example (Optional)
# All parameters possess safe built-in defaults; overrides are optional.
# ============================================================

# Service Identity
ADAPTIPING_API_TITLE="AdaptiPing Simulation API"
ADAPTIPING_API_VERSION="0.1.0"

# Permitted CORS Origins (JSON array format)
ADAPTIPING_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Bench Hardware Model Defaults
ADAPTIPING_DAC_RESOLUTION_BITS=12
ADAPTIPING_DEFAULT_SAMPLE_RATE_HZ=1000000.0
ADAPTIPING_MODELED_FILTER_CUTOFF_HZ=300000.0

# Resource Boundaries (DoS & Memory Exhaustion Protection)
ADAPTIPING_MAX_DURATION_MS=50.0
ADAPTIPING_MIN_DURATION_MS=0.1
ADAPTIPING_MAX_SAMPLE_RATE_HZ=2000000.0
ADAPTIPING_MAX_TOTAL_SAMPLES=100000
ADAPTIPING_MAX_HISTORY_RECORDS=50
